rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────
    // Each user can only read and write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Transactions ────────────────────────────────────────────────────────
    // Any authenticated user can CREATE (after successful Razorpay payment).
    // Only admin can LIST or GET all transactions (for the admin dashboard).
    match /transactions/{txId} {
      allow create: if request.auth != null;
      allow list, get: if request.auth != null
        && request.auth.token.email == 'admin@codebazaar.com';
      allow update, delete: if false;
    }
  }
}
